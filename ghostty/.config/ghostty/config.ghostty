# Ghostty v1 baseline — see docs/research/ghostty-config-linux-gnome.md
# Path: ghostty/.config/ghostty/config.ghostty (Stow target: ~/.config/ghostty/)
# Mizuki is the house theme (see themes/mizuki); GNOME light/dark no longer
# swaps the terminal, matching the dark-only bash/tmux/nvim scheme.
theme = mizuki
font-family = "JetBrains Mono"
font-size = 12

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab

shell-integration-features = sudo

# Per-machine overrides (gitignored).
config-file = ?config.local

# No server-side decorations: borderless window, top bar included.
window-decoration = false

# Frosted-glass shell: translucent window + blurred wallpaper behind it.
background-opacity = 0.8
background-blur = 20

# Full glass: terminal apps (nvim/tmux) go translucent too — readability tradeoff accepted.
background-opacity-cells = true

# Content padding between terminal text and window edge.
window-padding-x = 10
window-padding-y = 10
